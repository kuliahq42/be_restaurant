// ---------------------------------------------------------------------------
// Restaurant Ordering, Inventory & Accounting System
// Prisma schema (PostgreSQL)
//
// Conventions:
//   - Every primary/foreign key is BigInt (PostgreSQL BIGINT).
//   - Models are PascalCase in Prisma; tables are lowercased via @@map.
//   - Columns are mapped to snake_case (@map) to match the SQL naming style.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Direction of an inventory movement in the accounting audit trail.
enum MovementType {
  in
  out
}

// ------------------------------- AUTH & USERS ------------------------------

model User {
  id         BigInt   @id @default(autoincrement())
  phone      String   @unique
  pin        String
  name       String?
  email      String?  @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  orders   Order[]
  sessions Session[]

  @@map("users")
}

model OtpRequest {
  id         BigInt   @id @default(autoincrement())
  phone      String
  otp_code   String
  expires_at DateTime
  is_used    Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([phone])
  @@map("otp_requests")
}

model Session {
  id           BigInt   @id @default(autoincrement())
  userId       BigInt   @map("user_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  payload      String?  @db.Text
  lastActivity DateTime @map("last_activity")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ----------------------------------- RBAC ----------------------------------

model Admin {
  id         BigInt   @id @default(autoincrement())
  username   String   @unique
  password   String // bcrypt hash
  role       String   @default("CASHIER") // MASTER | ADMIN_KITCHEN | CHEF | PURCHASING | ACCOUNTANT | CASHIER
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("admins")
}

// --------------------------------- CATALOG ---------------------------------

model Category {
  id         BigInt   @id @default(autoincrement())
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id          BigInt   @id @default(autoincrement())
  category_id BigInt
  name        String
  label       String?
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 2)
  image       String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  category Category        @relation(fields: [category_id], references: [id], onDelete: Restrict)
  items    OrderItem[]
  recipes  ProductRecipe[]

  @@index([category_id])
  @@map("products")
}

// -------------------------------- TRANSACTION ------------------------------

model Order {
  id             BigInt   @id @default(autoincrement())
  user_id        BigInt
  invoice_number String   @unique
  table_number   String?
  total          Decimal  @db.Decimal(14, 2)
  status         String   @default("PENDING") // PENDING | PAID | COMPLETED | CANCELLED
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  user     User        @relation(fields: [user_id], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]

  @@index([user_id])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id             BigInt  @id @default(autoincrement())
  order_id       BigInt
  product_id     BigInt
  quantity       Int
  price          Decimal @db.Decimal(12, 2)
  item_total     Decimal @db.Decimal(14, 2)
  notes          String?
  kitchen_status String  @default("PENDING") // PENDING | COOKING | READY | SERVED

  order   Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@index([order_id])
  @@index([product_id])
  @@map("order_items")
}

// --------------------------------- PAYMENT ---------------------------------

model Payment {
  id             BigInt   @id @default(autoincrement())
  order_id       BigInt
  payment_method String // CASH | QRIS | CARD | EWALLET | TRANSFER
  amount         Decimal  @db.Decimal(14, 2)
  status         String   @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  transaction_id String?
  created_at     DateTime @default(now())

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("payments")
}

// -------------------------- INVENTORY & ACCOUNTING -------------------------

model InventoryItem {
  id            BigInt   @id @default(autoincrement())
  name          String
  unit          String // gram | ml | pcs
  stock         Decimal  @default(0) @db.Decimal(14, 3)
  cost_per_unit Decimal  @db.Decimal(12, 2) // valuation basis for COGS
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  recipes   ProductRecipe[]
  movements StockMovement[]

  @@map("inventory_items")
}

/// Bill of Materials: how much of each InventoryItem a Product consumes.
model ProductRecipe {
  id                BigInt  @id @default(autoincrement())
  product_id        BigInt
  inventory_item_id BigInt
  quantity_needed   Decimal @db.Decimal(14, 3)

  product       Product       @relation(fields: [product_id], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventory_item_id], references: [id], onDelete: Restrict)

  @@unique([product_id, inventory_item_id])
  @@map("product_recipes")
}

/// Immutable ledger of every stock change: the accounting audit trail for material costs.
model StockMovement {
  id                BigInt       @id @default(autoincrement())
  inventory_item_id BigInt
  movement_type     MovementType // in = purchase/restock, out = consumption
  quantity          Decimal      @db.Decimal(14, 3)
  description       String?
  created_by        BigInt? // admin.id responsible for the movement (null = system)
  created_at        DateTime     @default(now())

  inventoryItem InventoryItem @relation(fields: [inventory_item_id], references: [id], onDelete: Restrict)

  @@index([inventory_item_id])
  @@map("stock_movements")
}

// --------------------------------- SETTINGS --------------------------------

model Setting {
  id               BigInt @id @default(autoincrement())
  restaurantStatus String @map("restaurant_status")

  @@map("settings")
}
